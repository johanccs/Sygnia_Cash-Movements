<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8, deliberately outside the net8.0 default in Directory.Build.props:
    ServiceHost (WCF server hosting) requires the full framework, and this is the one
    project in the solution that can't share that default. See CLAUDE.md's Known traps.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" />
  </ItemGroup>

  <ItemGroup>
    <!--
      movements.proto hardcodes `option csharp_namespace = "Sygnia.Presentation";`. Compiling it
      here means this project independently generates its own full copy of the Sygnia.Presentation.*
      message/client types, duplicating what Sygnia.Presentation.dll already exports under the same
      namespace. Nothing breaks today because no project references both this assembly and
      Sygnia.Presentation, but this project must NEVER be referenced (directly or transitively) by
      anything that also references Sygnia.Presentation — doing so collides on CS0433
      (ambiguous type) for every Sygnia.Presentation.* type. See CLAUDE.md's Known traps.
    -->
    <Protobuf Include="..\Sygnia.Presentation\Protos\movements.proto" GrpcServices="Client" Link="Protos\movements.proto" />
  </ItemGroup>

</Project>
